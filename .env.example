AUTOHUB_NOTIFICATION_EMAIL=your-email@example.com
AUTOHUB_SMTP_USER=your-gmail@example.com
AUTOHUB_SMTP_PASSWORD=PASTE_YOUR_GOOGLE_APP_PASSWORD_HERE

# Destination for your WhatsApp alerts. The leading +91 is India country code.
AUTOHUB_WHATSAPP_TO=+911234567890

# Meta provides a separate phone number ID for your WhatsApp Business sender.
AUTOHUB_WHATSAPP_PHONE_NUMBER_ID=
AUTOHUB_WHATSAPP_ACCESS_TOKEN=
AUTOHUB_WHATSAPP_TEMPLATE=autohub_notification
AUTOHUB_WHATSAPP_LANGUAGE=en_US
AUTOHUB_META_GRAPH_API_VERSION=v27.0

